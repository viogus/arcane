# syntax=docker/dockerfile:1
ARG VERSION="dev"
ARG REVISION="unknown"
ARG ARCANE_RUNTIME_BASE_IMAGE=ghcr.io/getarcaneapp/base:distroless

FROM --platform=$BUILDPLATFORM golang:1.27-trixie AS agent-builder
ARG TARGETARCH
ARG TARGETVARIANT
ARG BUILD_TAGS="exclude_frontend"
ARG VERSION="dev"
ARG REVISION="unknown"
ARG BUILD_TIME="unknown"
WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates tzdata curl jq \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY go.work ./
COPY types ./types
COPY cli ./cli
COPY backend/go.mod backend/go.sum ./backend/
WORKDIR /build/backend
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY backend ./
COPY .arcane.json ../arcane.json

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    if [ "${VERSION}" = "dev" ]; then VERSION=$(jq -r '.version // "dev"' ../arcane.json); fi && \
    if [ "${REVISION}" = "unknown" ]; then REVISION=$(jq -r '.revision // "unknown"' ../arcane.json); fi && \
    if [ "${BUILD_TIME}" = "unknown" ]; then BUILD_TIME=$(jq -r '.buildTime // "unknown"' ../arcane.json); fi && \
    export GOARCH="${TARGETARCH}" && \
    if [ "${TARGETARCH}" = "arm" ]; then \
    GOARM="${TARGETVARIANT#v}"; \
    if [ -z "${GOARM}" ]; then GOARM="7"; fi; \
    export GOARM; \
    fi && \
    CGO_ENABLED=0 GOOS=linux \
    go build \
    -tags "${BUILD_TAGS}" \
    -ldflags "-w -s -X github.com/getarcaneapp/arcane/backend/v2/internal/config.Version=${VERSION} -X github.com/getarcaneapp/arcane/backend/v2/internal/config.Revision=${REVISION} -X github.com/getarcaneapp/arcane/backend/v2/internal/config.BuildTime=${BUILD_TIME}" \
    -trimpath \
    -o /out/arcane-agent \
    ./cmd/main.go

RUN mkdir -p /out/rootfs/app/data

# Files the distroless base normally provides and a scratch runtime needs: a minimal account
# table and a world-writable /tmp.
RUN mkdir -p /out/lean-rootfs/tmp /out/lean-rootfs/etc \
    && chmod 1777 /out/lean-rootfs/tmp \
    && printf 'root:x:0:0:root:/root:/bin/sh\nnonroot:x:65532:65532:nonroot:/app/data:/bin/sh\n' > /out/lean-rootfs/etc/passwd \
    && printf 'root:x:0:\nnonroot:x:65532:\n' > /out/lean-rootfs/etc/group

FROM ${ARCANE_RUNTIME_BASE_IMAGE} AS agent
ARG TARGETARCH

WORKDIR /app

USER 0:0
COPY --from=agent-builder --chown=65532:65532 /out/rootfs/app/ /app/
COPY --from=agent-builder --chown=65532:65532 /out/arcane-agent ./arcane-agent

ARG VERSION="dev"
ARG REVISION="unknown"

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    ROCR_VISIBLE_DEVICES=all \
    HIP_VISIBLE_DEVICES=all \
    ONEAPI_DEVICE_SELECTOR=level_zero:*,opencl:* \
    LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/opt/rocm/lib:/opt/intel/oneapi/lib:/opt/intel/oneapi/lib/intel64:/usr/lib/x86_64-linux-gnu:/usr/lib/aarch64-linux-gnu:/usr/lib64:/usr/lib:/lib64:/lib

ENV ENVIRONMENT=production \
    ARCANE_IN_CONTAINER=true \
    AGENT_MODE=true \
    GIN_MODE=release \
    PORT=3553

EXPOSE 3553
VOLUME ["/app/data"]

LABEL com.getarcaneapp.arcane.agent="true"

CMD ["./arcane-agent"]

# Lean agent image: the same binary on an empty base, without the distroless runtime.
# Selected with --target agent-lean by the publish workflow.
FROM scratch AS agent-lean

ARG TARGETARCH

WORKDIR /app

USER 0:0

COPY --from=agent-builder --chown=65532:65532 /out/rootfs/app/ /app/
COPY --from=agent-builder --chown=65532:65532 /out/lean-rootfs/ /
COPY --from=ghcr.io/getarcaneapp/base:distroless /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=agent-builder --chown=65532:65532 /out/arcane-agent ./arcane-agent

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    ROCR_VISIBLE_DEVICES=all \
    HIP_VISIBLE_DEVICES=all \
    ONEAPI_DEVICE_SELECTOR=level_zero:*,opencl:* \
    LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/opt/rocm/lib:/opt/intel/oneapi/lib:/opt/intel/oneapi/lib/intel64:/usr/lib64:/usr/lib:/lib64:/lib \
    PATH=/app:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    ENVIRONMENT=production \
    ARCANE_IN_CONTAINER=true \
    AGENT_MODE=true \
    GIN_MODE=release \
    PORT=3553

EXPOSE 3553
VOLUME ["/app/data"]

LABEL com.getarcaneapp.arcane.agent="true" \
      com.getarcaneapp.arcane.base="scratch-agent"

CMD ["./arcane-agent"]
